# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv/
venv/
ENV/
env/

# Environment Variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Jupyter Notebooks
.ipynb_checkpoints
# Allow notebooks in notebooks/ directory for Fabric deployment
!notebooks/*.ipynb

# Fabric artifacts
*.pbix
*.pbit

# Data files (if sensitive)
data/raw/
data/processed/

# Exclude Bronze/Silver/Gold layer tables (contain processed data)
data/bronze_tables/*.parquet
data/silver_tables/*.parquet
data/gold_tables/*.parquet

# Exclude all CSV/Excel except reference and mock data
*.csv
*.xlsx
!data/reference/*.csv
!powerbi/mock_data/*.csv

# Exclude real situation reports (only keep synthetic samples)
data/sample/*
!data/sample/cholera_sitrep_2025_wk06.pdf
!data/sample/cholera_sitrep_2025_wk07.pdf
!data/sample/cholera_sitrep_2025_wk08.pdf
!data/sample/.gitkeep

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Sensitive documentation (may contain real data references)
VALIDATION_REPORT.md
DELIVERABLES_SUMMARY.md
*_INTERNAL.md
*_CONFIDENTIAL.md

# Backup files
*.backup
*.bak
*.tmp
