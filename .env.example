# Fabric Configuration
FABRIC_WORKSPACE_ID=your-workspace-id-here
FABRIC_LAKEHOUSE_ID=your-lakehouse-id-here
FABRIC_WAREHOUSE_ID=your-warehouse-id-here
ONELAKE_ENDPOINT=https://onelake.dfs.fabric.microsoft.com

# Azure Authentication
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# Data Processing
BRONZE_PATH=Files/bronze/pdfs
SILVER_SCHEMA=silver
GOLD_SCHEMA=gold

# Quality Thresholds
MIN_EXTRACTION_CONFIDENCE=0.90
CFR_TOLERANCE_PERCENT=0.5

# ML Model Parameters
PROPHET_FORECAST_WEEKS=4
PROPHET_CHANGEPOINT_PRIOR=0.05

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/cdr_pipeline.log

# Email Notifications
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
NOTIFICATION_EMAIL=cdr-ops@africacdc.org
